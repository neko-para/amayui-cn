{
  "name": "@amayui/uimap",
  "version": "0.1.0",
  "description": "A dsh bundle plugin: the model-visible `amayui_uimap` tool (scan a 天結 UI PNG's alpha-connected blocks) plus an in-conversation map/clean-workbench UI that selects blocks, fills them, and exports a clean plan + clean_fill.py script.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  }
}
