{
  "name": "amayui-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AGE 引擎 VM 的 TypeScript 重写：加载 .BIN 脚本并逐条执行（无界面，先跑到 TITLE；接入 Electron 渲染壳）",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run": "tsx src/run.ts",
    "test": "node --import tsx test/run.ts fast",
    "test:corpus": "node --import tsx test/run.ts corpus",
    "test:e4": "node --import tsx test/run.ts e4",
    "test:all": "node --import tsx test/run.ts all",
    "test:list": "node --import tsx test/run.ts list",
    "test:org": "node --import tsx test/run.ts check",
    "test:unpinned": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.control.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:test && npm run test:all && npm run check:dead-writes",
    "boot:time": "node tools/boottime.cjs",
    "build:electron": "node build-electron.mjs",
    "check:dead-writes": "tsx src/tools/deadWrites.ts",
    "mutate": "tsx src/tools/mutate.ts",
    "dbg": "node tools/dbg.cjs",
    "dbg:srv": "npm run build:electron && electron tools/debugsrv.cjs",
    "diag:text": "tsx src/tools/diagText.ts",
    "electron": "electron .",
    "electron:dev": "npm run build:electron && electron .",
    "op:inventory": "tsx src/tools/opInventory.ts",
    "record": "npm run build:electron && electron tools/record.cjs",
    "replay": "tsx src/tools/replay.ts",
    "report": "tsx src/report.ts",
    "save:dump": "tsx src/tools/saveDump.ts",
    "scenario": "tsx src/tools/scenarioRun.ts",
    "shot": "npm run build:electron && electron tools/shot.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^44.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  }
}
