<Window x:Class="AmayuiInspector.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AmayuiInspector.App.Views"
        Title="amayui-inspector" Height="960" Width="1600"
        MinHeight="640" MinWidth="960">
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#ECECEC" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="进程" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="220" VerticalAlignment="Center"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"/>
                <Button Content="刷新进程" Command="{Binding RefreshProcessesCommand}" Margin="6,0,0,0"/>
                <Button Content="扫描 this" Command="{Binding ScanThisCommand}" Margin="6,0,0,0" FontWeight="Bold"/>
                <Button Content="刷新快照" Command="{Binding RefreshSnapshotCommand}" Margin="6,0,0,0"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#444"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体 -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:EnginePanel Grid.Column="0" DataContext="{Binding Engine}"/>
            <TabControl Grid.Column="1">
                <TabItem Header="全局表">
                    <views:GlobalTableControl DataContext="{Binding GlobalTable}"/>
                </TabItem>
                <TabItem Header="脚本帧/调用栈">
                    <views:FrameStackControl DataContext="{Binding Frames}"/>
                </TabItem>
                <TabItem Header="opcode 表">
                    <TextBlock Text="M3：按 docs/re/engine/06 + semantic_names 做命名对照" Margin="10"/>
                </TabItem>
                <TabItem Header="Hex">
                    <TextBlock Text="M4：十六进制视图" Margin="10"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
