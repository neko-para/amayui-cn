<UserControl x:Class="AmayuiInspector.App.Views.GlobalTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="6" Background="#F5F5F5">
            <StackPanel>
                <!-- 行 1：范围 / 过滤 / 全量 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="过滤" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Width="100" VerticalAlignment="Center" SelectedIndex="{Binding FilterIndex}">
                        <ComboBoxItem Content="仅非空"/>
                        <ComboBoxItem Content="仅掉落区"/>
                        <ComboBoxItem Content="全部"/>
                    </ComboBox>
                    <TextBlock Text="范围(hex)" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Width="90" VerticalAlignment="Center" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text=".." VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox Width="90" VerticalAlignment="Center" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="加载" Command="{Binding LoadCommand}" Margin="10,0,0,0" FontWeight="Bold"/>
                    <Button Content="全量" Command="{Binding FullLoadCommand}" Margin="6,0,0,0" ToolTip="范围 0..区段末，加载到 ≈8M 槽"/>
                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox Width="150" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding MaxSlotsText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
                </StackPanel>

                <!-- 行 2：分页 -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="每页" VerticalAlignment="Center"/>
                    <ComboBox Width="90" VerticalAlignment="Center" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"/>
                    <Button Content="◀" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrev}" Margin="10,0,0,0" Width="30"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNext}" Width="30"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="6" Background="#EAF2FA">
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"/>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="索引" Binding="{Binding IndexText}" SortMemberPath="Index" Width="120"/>
                <DataGridTextColumn Header="值" Binding="{Binding ValueText}" Width="120"/>
                <DataGridTextColumn Header="区域" Binding="{Binding ZoneText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
