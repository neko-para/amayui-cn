<UserControl x:Class="AmayuiInspector.App.Views.EnginePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="引擎状态" FontWeight="Bold" Margin="4,0,0,6"/>

            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="4">
                <StackPanel>
                    <TextBlock Text="核心定位" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="this" Grid.Row="0" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding This}" Grid.Row="0" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="模块基址" Grid.Row="1" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Module}" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="key" Grid.Row="2" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Key}" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="4">
                <StackPanel>
                    <TextBlock Text="全局数组基址" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="int" Grid.Row="0" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding IntBase}" Grid.Row="0" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="float" Grid.Row="1" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding FloatBase}" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="string" Grid.Row="2" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding StrBase}" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="ptr" Grid.Row="3" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding PtrBase}" Grid.Row="3" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="float-ptr" Grid.Row="4" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding FptrBase}" Grid.Row="4" Grid.Column="1" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="4">
                <StackPanel>
                    <TextBlock Text="控制流寄存器" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="cur_script" Grid.Row="0" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Cur}" Grid.Row="0" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="call_ret" Grid.Row="1" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Ret}" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="call_link" Grid.Row="2" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Link}" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Text="call_flag" Grid.Row="3" Grid.Column="0" Foreground="#666"/>
                        <TextBlock Text="{Binding Flag}" Grid.Row="3" Grid.Column="1" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,8,4,0" Foreground="#888" TextWrapping="Wrap"
                       Text="提示：先选进程 →「扫描 this」；「刷新快照」重读当前 this 状态。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
