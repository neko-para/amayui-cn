<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AmayuiInspector.App</RootNamespace>
    <AssemblyName>AmayuiInspector.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmayuiInspector.Core\AmayuiInspector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全局字符串展示用的「日文写法 → 简体」反查字典（构建时嵌入，运行时读资源） -->
    <EmbeddedResource Include="..\..\..\res\subs_cn_jp.json" Link="Resources\subs_cn_jp.json" />
  </ItemGroup>

</Project>
